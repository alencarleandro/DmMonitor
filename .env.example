# Copie para .env. O backend lê este arquivo quando iniciado na raiz.
DMMONITOR_ENV=development
PORT=8087
PUBLIC_URL=http://127.0.0.1:5175
DATABASE_URL=postgres://dmmonitor:dmmonitor_local@localhost:5432/dmmonitor?sslmode=disable
GOOGLE_CLIENT_ID=
# Opcional: ativa o fluxo de redirecionamento OAuth em vez do botão Identity Services.
GOOGLE_CLIENT_SECRET=
# Google: cadastrar PUBLIC_URL nas origens JavaScript autorizadas.
# Com CLIENT_SECRET: cadastrar também PUBLIC_URL + /auth/google/callback nos redirects.
STATIC_DIR=web/dist
