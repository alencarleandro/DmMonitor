# Copie para .env. O backend lê este arquivo quando iniciado na raiz.
DMMONITOR_ENV=development
PORT=8087
PUBLIC_URL=http://127.0.0.1:5175
DATABASE_URL=postgres://dmmonitor:dmmonitor_local@localhost:5432/dmmonitor?sslmode=disable
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google: cadastrar PUBLIC_URL + /auth/google/callback como redirect URI.
STATIC_DIR=web/dist
